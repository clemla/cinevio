# Port d'écoute
PORT=7000

# URL publique du serveur (sans / final). Sinon déduite de la requête.
# PUBLIC_URL=https://mon-addon.exemple.fr

# Nom et identifiant de l'addon. Si tu changes ADDON_ID après la publication,
# les collections déjà importées ne trouveront plus l'addon.
ADDON_NAME=Cinévio
ADDON_ID=community.nuviofr

# Clés de l'instance. TMDB est conseillée : elle sert aux top 10 partagés
# (calculés une fois pour tout le monde). Les utilisateurs peuvent aussi mettre
# leurs propres clés sur la page de configuration.
TMDB_API_KEY=
FANART_API_KEY=
MDBLIST_API_KEY=

# Top 10 : fréquence de lecture de FlixPatrol (heures). FLIXPATROL_DISABLED=1 coupe la source.
FLIXPATROL_REFRESH_HOURS=12
# FLIXPATROL_DISABLED=1
# FlixPatrol est protégé par Cloudflare : les pages sont ouvertes avec Chrome/Edge installé.
#   auto = essai direct puis navigateur (défaut) · browser = toujours le navigateur · direct = jamais
# FLIXPATROL_FETCH=auto
# Chemin du navigateur si Chrome/Edge n'est pas trouvé automatiquement
# BROWSER_PATH=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
# auto = invisible puis fenêtre hors écran si besoin · 1 = toujours invisible · 0 = toujours en fenêtre
# BROWSER_HEADLESS=auto
# Dernier vrai classement gardé (heures) si FlixPatrol est en panne
# FLIXPATROL_KEEP_LAST_HOURS=72
# Attente max d'une rangée quand rien n'est encore en cache (secondes)
# FLIXPATROL_WAIT_SECONDS=8
# BOXOFFICE_DISABLED=1

# Lien public Cloudflare (https), pour utiliser l'addon sur ton téléphone, ta télé ou hors de chez toi.
# Le plus simple : lance lancer-cloudflare.bat. cloudflared est téléchargé tout seul la première fois.
#   CLOUDFLARE_TUNNEL=1 : lien rapide sans compte (*.trycloudflare.com), nouveau à chaque lancement
# CLOUDFLARE_TUNNEL=1
#   Lien fixe : crée un tunnel dans ton compte Cloudflare (Zero Trust → Réseaux → Tunnels),
#   relie-le à http://localhost:7000, puis mets son jeton et son adresse :
# CLOUDFLARE_TUNNEL_TOKEN=
# PUBLIC_URL=https://cinevio.mondomaine.fr
# CLOUDFLARED_PATH=C:\chemin\vers\cloudflared.exe

# Dossier du cache disque
# DATA_DIR=./data

# Cartes des collections refaites chaque jour avec les affiches du moment (0 = cartes de secours seulement)
# COVERS_DYNAMIC=1
# GIF animés joués quand une carte a le focus dans Nuvio (0 = cartes fixes seulement)
# COVERS_GIF=1
# Cartes dessinées en même temps (une par onglet du navigateur). Plus = plus rapide, mais plus de processeur.
# RENDER_CONCURRENCY=3
